+	}
+	return tool.ToolSourceMetadata{
+		Kind:        tool.ToolSourceBuiltin,
+		ProducerID:  "emoagent.builtin",
+		RuntimeKind: resultv2.RuntimeHost,
+		DefaultLabels: resultv2.ContentLabels{
