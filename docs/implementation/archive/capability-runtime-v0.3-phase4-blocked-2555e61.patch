+func TestBubblewrapArgsBindOnlyWorkspaceRWAndTmpfsTemp(t *testing.T) {
+	args, err := bubblewrapArgs(CommandRequest{
+		Command:      []string{"sh", "-c", "echo ok"},
+		WorkspaceDir: "/repo",
+		Profile: SandboxProfile{
+			WorkspaceMode: "rw",
+			TempMode:      "rw",
+			PersonalMode:  "ro",
+			NetworkMode:   NetworkDeny,
