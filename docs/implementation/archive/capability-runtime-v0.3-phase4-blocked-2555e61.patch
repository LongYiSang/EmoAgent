+
+func TestPhase0SandboxPlanContractCompile(t *testing.T) {
+	plan := SandboxPlan{
+		PlanVersion:        PlanVersion,
+		InstanceID:         "inst-1",
+		PluginID:           "com.example.echo",
+		PluginVersion:      "0.3.0",
+		ImageDigest:        "sha256:image",
+		RuntimeProfile:     "python-3.12-minimal",
+		Command:            []string{"python", "main.py"},
+		Environment:        map[string]string{"PYTHONUNBUFFERED": "1"},
+		NetworkMode:        NetworkNone,
+		CPUQuota:           0.5,
+		MemoryBytes:        256 << 20,
+		PidsLimit:          64,
+		ReadOnlyRootFS:     true,
+		NoNewPrivileges:    true,
+		CapDropAll:         true,
+		SeccompProfile:     SeccompDefault,
+		EffectiveGrantHash: "sha256:grant",
+		PlanHash:           "sha256:plan",
+		Mounts: []SandboxMount{{
+			Kind:          MountTmpfs,
+			ContainerPath: "/tmp",
+			Mode:          MountModeRW,
+		}},
+	}
+	if plan.NetworkMode != NetworkNone || !plan.ReadOnlyRootFS || !plan.CapDropAll {
+		t.Fatalf("sandbox plan contract mismatch: %#v", plan)
+	}
+}
