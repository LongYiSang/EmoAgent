+	if binding.PathDigest == "" ||
+		!strings.Contains(binding.InputPreview, "changeset_id=cs-1") ||
+		!strings.Contains(binding.InputPreview, "recursive=true") ||
+		strings.Contains(binding.InputPreview, "file-id") {
