+
+func bashSandboxProfile(cfg config.BashConfig, timeoutSec int) execution.SandboxProfile {
+	networkMode := execution.NetworkDeny
+	if cfg.NetworkDefault == "allow" {
+		networkMode = execution.NetworkAllow
+	}
+	return execution.SandboxProfile{
+		WorkspaceMode: "rw",
+		TempMode:      "rw",
+		PersonalMode:  "ro",
+		NetworkMode:   networkMode,
+		EnvAllowlist:  []string{"PATH", "HOME", "TMPDIR", "TMP", "TEMP"},
+		Limits: execution.CommandLimits{
+			TimeoutSeconds: timeoutSec,
+			CPUQuota:       cfg.CPUs,
+			MemoryBytes:    int64(cfg.MemoryMB) << 20,
+			MaxProcesses:   cfg.MaxProcesses,
+			MaxOutputBytes: cfg.MaxOutputBytes,
+		},
+	}
+}
+
+func bashDriverForOS(goos string, cfg config.BashConfig) string {
+	switch strings.ToLower(goos) {
+	case "linux":
+		return cfg.LinuxDriver
+	case "darwin":
+		return cfg.MacOSDriver
+	case "windows":
+		return cfg.WindowsDriver
+	default:
+		return ""
+	}
+}
