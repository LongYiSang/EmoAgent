+	}
+
+	mutated := call
+	mutated.Input = json.RawMessage(`{"changeset_id":"cs-1","plan_hash":"sha256:changed"}`)
+	mutatedBinding, err := BuildApprovalBinding(mutated, "approval-1", ApprovalKindDestructiveWrite)
