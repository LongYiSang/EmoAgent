+package execution
+
+import (
+	"context"
+	"os"
+	"path/filepath"
+	"runtime"
+	"strings"
+	"testing"
+)
+
+func TestBubblewrapSandboxIntegrationWorkspaceBoundary(t *testing.T) {
+	if runtime.GOOS != "linux" {
+		t.Skip("bubblewrap integration requires linux")
+	}
+	if os.Getenv("EMO_SANDBOX_INTEGRATION") != "1" {
+		t.Skip("set EMO_SANDBOX_INTEGRATION=1 to run sandbox boundary integration tests")
+	}
+	sandbox := BubblewrapSandbox{}
+	probe, err := sandbox.Probe(context.Background(), ProbeRequest{Driver: "bubblewrap"})
+	if err != nil {
+		t.Fatalf("Probe: %v", err)
+	}
+	if !probe.Available {
+		t.Fatalf("bubblewrap unavailable in integration mode: %s", probe.Reason)
+	}
+
+	workspace := t.TempDir()
+	outside := t.TempDir()
+	result, err := sandbox.Execute(context.Background(), CommandRequest{
+		Command:      []string{"sh", "-c", "printf ok > inside.txt; printf leak > " + shellQuote(filepath.Join(outside, "outside.txt"))},
+		WorkspaceDir: workspace,
+		Profile: SandboxProfile{
+			WorkspaceMode: "rw",
+			TempMode:      "rw",
+			PersonalMode:  "ro",
+			NetworkMode:   NetworkDeny,
+			Limits:        CommandLimits{TimeoutSeconds: 5, MaxOutputBytes: 4096, MaxProcesses: 8},
+		},
+	})
+	if err != nil {
+		t.Fatalf("Execute: %v", err)
+	}
+	if result.Unavailable {
+		t.Fatalf("sandbox unavailable: %#v", result)
+	}
+	if _, err := os.Stat(filepath.Join(workspace, "inside.txt")); err != nil {
+		t.Fatalf("workspace write failed: %v; result=%#v", err, result)
+	}
+	if _, err := os.Stat(filepath.Join(outside, "outside.txt")); !os.IsNotExist(err) {
+		t.Fatalf("outside write escaped sandbox: %v; result=%#v", err, result)
+	}
+}
+
+func shellQuote(value string) string {
+	return "'" + strings.ReplaceAll(value, "'", "'\\''") + "'"
+}
